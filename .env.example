# 复制为 .env 后填入真实值；.env 权限设为 600，且不要提交到版本库

# ---- QQ 开放平台（机器人管理端 -> 开发设置）----
QQBOT_APP_ID=
QQBOT_APP_SECRET=

# websocket（默认，单机自托管首选） | webhook
QQBOT_TRANSPORT=websocket

# 机器人是否具备 Markdown 权限（msg_type=2）
QQBOT_MARKDOWN_SUPPORT=false

# debug | info | warn | error（日志只写 stdout/stderr，由 journald 收集与轮转）
QQBOT_LOG_LEVEL=info

# 进程级数据目录（SQLite 数据库、插件私有文件都放这里）
QQBOT_DATA_DIR=data
# 聊天记录保留天数（启动时清理更早的记录）
# QQBOT_MESSAGE_RETENTION_DAYS=60
# 计算「今天」用的时区（签到、AI 预算共用）。服务器多为 UTC，不设会在早上 8 点翻页
# QQBOT_TIMEZONE=Asia/Shanghai
# 周期 health 日志间隔（秒）；0 表示关闭。journald 里 grep '"msg":"health"' 看趋势
# QQBOT_HEALTH_INTERVAL_SEC=300

# 单用户限流窗口（毫秒）：窗口内只放行一条，超出的直接丢弃；0 表示关闭
# QQBOT_RATE_LIMIT_PER_USER_MS=2000

# ---- DeepSeek ----
QQBOT_AI_API_KEY=
# QQBOT_AI_BASE_URL=https://api.deepseek.com
# QQBOT_AI_MODEL=deepseek-flash
# QQBOT_AI_MAX_TOKENS=1024
# 关闭 thinking：none | low | high | max（默认 none，因为默认 high 会拉长延迟）
# QQBOT_AI_REASONING_EFFORT=none
# 单次请求超时（毫秒）
# QQBOT_AI_TIMEOUT_MS=60000

# ---- 预算熔断 ----
# 每日上限（元）；定位是「跑飞时的闸门」，不是省钱手段
# QQBOT_AI_DAILY_BUDGET_CNY=20
# 计价（元 / 百万 token），默认取高峰价做保守估算
# QQBOT_AI_PRICE_IN_CNY_PER_M=2.2
# QQBOT_AI_PRICE_OUT_CNY_PER_M=8.6

# ---- 上下文 ----
# QQBOT_AI_CONTEXT_MESSAGES=10
# QQBOT_AI_CONTEXT_CHARS=4000

# ---- 内容安全（C3 的确定性地板；第一道防线是 system prompt 里的模型自审）----
# 追加敏感词，逗号分隔
# QQBOT_SAFETY_EXTRA_TERMS=
# QQBOT_SAFETY_REFUSAL_TEXT=这个问题我没法回答，换个话题吧。

# ---- 形象（SillyTavern 角色卡）----
# 卡片目录：每张卡一个子目录，放 card.png / card.jpg / card.webp / card.json
# QQBOT_PERSONAS_DIR=data/personas
# 指针文件：内容是一行 slug（即子目录名）；文件缺失或为空 = 用内置人设
# QQBOT_PERSONA_FILE=data/persona

# ---- DSH agent ----
# 关掉就回落到直连 DeepSeek 的旧路径
# QQBOT_AGENT_ENABLED=1
# dsh 不在 systemd 默认 PATH 里，通常要写绝对路径
# QQBOT_AGENT_BIN=/home/kai/.npm-global/bin/dsh
# QQBOT_AGENT_PROFILE=headless
# 这个补丁禁用全部工具，只留对话能力——不要去掉
# QQBOT_AGENT_PATCH=deploy/agent-chat.patch.yml
# QQBOT_AGENT_TIMEOUT_MS=120000

# ---- 插件配置 ----
# 插件由 src/plugins/features/ 自动发现，不需要在这里登记。
# 命名规则：QQBOT_PLUGIN_<插件名>_<字段名>（大小写不敏感）；未配置 ENABLED 时默认启用。
# 注意：chat 插件会接管所有非 / 开头的消息，启用后 echo 插件实际不会再被触发。
# QQBOT_PLUGIN_CHAT_ENABLED=true
# QQBOT_PLUGIN_PING_ENABLED=true
# QQBOT_PLUGIN_ECHO_ENABLED=false
